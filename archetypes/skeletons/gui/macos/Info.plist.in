<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Application name -->
    <key>CFBundleName</key>
    <string>@APP_NAME@</string>

    <!-- Executable name (same as target) -->
    <key>CFBundleExecutable</key>
    <string>@APP_NAME@</string>

    <!-- Unique bundle identifier (reverse-DNS notation) -->
    <key>CFBundleIdentifier</key>
    <string>@BUNDLE_ID@</string>

    <!-- Bundle version -->
    <key>CFBundleVersion</key>
    <string>@APP_VERSION@</string>

    <!-- Bundle display name -->
    <key>CFBundleDisplayName</key>
    <string>@APP_NAME@</string>

    <!-- Icon file (placed in Contents/Resources/) -->
    <key>CFBundleIconFile</key>
    <string>app_icon</string>

    <!-- Main menu nib (optional; remove if using SwiftUI) -->
    <!--
    <key>CFBundleMainStoryboardFile</key>
    <string>Main</string>
    -->

    <!-- Required on macOS 10.9+ -->
    <key>NSHighResolutionCapable</key>
    <true/>
</dict>
</plist>
