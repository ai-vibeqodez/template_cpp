// resource.h — Win32 resource header
//
// This file is a skeleton for the resource header used by the
// Win32 resource script (.rc) for GUI applications.

#pragma once

/**
 * @file resource.h
 * @brief Win32 resource identifiers (icon, version info).
 */

// Icon identifiers
#define IDI_APPLICATION_ICON      101
#define IDI_APPLICATION_SMALL_ICON 102

// Version information
#define VS_VERSION_INFO
#define VER_FILE_VERSION            1,0,0,0
#define VER_FILE_VERSION_STR        "1.0.0.0\0"

#define VER_PRODUCT_VERSION         1,0,0,0
#define VER_PRODUCT_VERSION_STR     "1.0.0.0\0"
