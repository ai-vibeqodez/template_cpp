# =============================================================================
# Example: how to call aw_add_header_only_library() from your project's
# root CMakeLists.txt.
#
# Copy this block and adapt the target name, header paths, and optional
# arguments to your project.
# =============================================================================

aw_add_header_only_library(TARGET my_header_lib
    HEADERS include/aw/my_header_lib/my_header_lib.hpp
    BASE_DIRS include
    LINK_LIBRARIES Threads::Threads
)
