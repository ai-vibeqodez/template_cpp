# Generic target helpers for shared project conventions.

function(aw_add_library)
    set(_oneValue TARGET TYPE ALIAS)
    set(_multiValue SOURCES HEADERS PUBLIC_INCLUDE_DIRS PRIVATE_INCLUDE_DIRS PUBLIC_LINKS PRIVATE_LINKS)
    set(_options STRICT_WARNINGS)
    cmake_parse_arguments(_LIB "${_options}" "${_oneValue}" "${_multiValue}" ${ARGN})

    if(NOT _LIB_TARGET OR NOT _LIB_TYPE)
        message(FATAL_ERROR "aw_add_library() requires TARGET and TYPE arguments")
    endif()
    if(NOT _LIB_TYPE MATCHES "^(STATIC|SHARED|MODULE|OBJECT|INTERFACE)$")
        message(FATAL_ERROR "aw_add_library() TYPE must be STATIC, SHARED, MODULE, OBJECT, or INTERFACE")
    endif()

    if(_LIB_TYPE STREQUAL "INTERFACE")
        add_library(${_LIB_TARGET} INTERFACE)
    else()
        add_library(${_LIB_TARGET} ${_LIB_TYPE} ${_LIB_SOURCES})
    endif()

    if(_LIB_ALIAS)
        add_library(${_LIB_ALIAS} ALIAS ${_LIB_TARGET})
    endif()

    if(NOT _LIB_TYPE STREQUAL "INTERFACE")
        target_compile_features(${_LIB_TARGET} PUBLIC cxx_std_23)
    endif()

    set(_public_includes)
    foreach(_include_dir IN LISTS _LIB_PUBLIC_INCLUDE_DIRS)
        if(IS_ABSOLUTE "${_include_dir}")
            list(APPEND _public_includes "${_include_dir}")
        else()
            list(APPEND _public_includes "${CMAKE_CURRENT_SOURCE_DIR}/${_include_dir}")
        endif()
    endforeach()
    if(_public_includes)
        target_include_directories(${_LIB_TARGET} PUBLIC
            $<BUILD_INTERFACE:${_public_includes}>
            $<INSTALL_INTERFACE:include>)
    endif()
    if(_LIB_PRIVATE_INCLUDE_DIRS)
        set(_private_includes)
        foreach(_include_dir IN LISTS _LIB_PRIVATE_INCLUDE_DIRS)
            if(IS_ABSOLUTE "${_include_dir}")
                list(APPEND _private_includes "${_include_dir}")
            else()
                list(APPEND _private_includes "${CMAKE_CURRENT_SOURCE_DIR}/${_include_dir}")
            endif()
        endforeach()
        target_include_directories(${_LIB_TARGET} PRIVATE ${_private_includes})
    endif()
    if(_LIB_PUBLIC_LINKS)
        target_link_libraries(${_LIB_TARGET} PUBLIC ${_LIB_PUBLIC_LINKS})
    endif()
    if(_LIB_PRIVATE_LINKS)
        target_link_libraries(${_LIB_TARGET} PRIVATE ${_LIB_PRIVATE_LINKS})
    endif()

    if(_LIB_HEADERS AND NOT _LIB_TYPE STREQUAL "INTERFACE")
        target_sources(${_LIB_TARGET}
            PUBLIC
                FILE_SET HEADERS
                BASE_DIRS ${_LIB_PUBLIC_INCLUDE_DIRS}
                FILES ${_LIB_HEADERS})
    endif()

    if(COMMAND aw_configure_compiler AND NOT _LIB_TYPE STREQUAL "INTERFACE")
        if(_LIB_STRICT_WARNINGS)
            aw_configure_compiler(TARGET ${_LIB_TARGET} STRICT_WARNINGS)
        else()
            aw_configure_compiler(TARGET ${_LIB_TARGET})
        endif()
    endif()
endfunction()

function(aw_add_executable)
    set(_oneValue TARGET)
    set(_multiValue SOURCES INCLUDE_DIRS LINK_LIBRARIES)
    cmake_parse_arguments(_EXE "STRICT_WARNINGS" "${_oneValue}" "${_multiValue}" ${ARGN})

    if(NOT _EXE_TARGET OR NOT _EXE_SOURCES)
        message(FATAL_ERROR "aw_add_executable() requires TARGET and SOURCES arguments")
    endif()

    add_executable(${_EXE_TARGET} ${_EXE_SOURCES})
    if(_EXE_INCLUDE_DIRS)
        target_include_directories(${_EXE_TARGET} PRIVATE ${_EXE_INCLUDE_DIRS})
    endif()
    if(_EXE_LINK_LIBRARIES)
        target_link_libraries(${_EXE_TARGET} PRIVATE ${_EXE_LINK_LIBRARIES})
    endif()
    if(COMMAND aw_configure_compiler)
        if(_EXE_STRICT_WARNINGS)
            aw_configure_compiler(TARGET ${_EXE_TARGET} STRICT_WARNINGS)
        else()
            aw_configure_compiler(TARGET ${_EXE_TARGET})
        endif()
    endif()
endfunction()
