// ModuleCard.cppm — C++20 module implementation unit
//
// Compile with:
//   g++ -fmodules -std=c++20 -c ModuleCard.cppm        (GCC)
//   clang++ -fmodules-ts -std=c++20 -c ModuleCard.cppm (Clang)
//   cl /experimental:module /std:c++latest /c ModuleCard.cppm  (MSVC)

module ModuleCard;

#include <string_view>

namespace aw::module_card {

std::string_view ModuleCard::greet(std::string_view name) {
    return "Hello from C++20 module";
}

} // namespace aw::module_card
