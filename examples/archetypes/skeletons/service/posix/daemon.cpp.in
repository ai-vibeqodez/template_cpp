// aw::__PROJECT_NAME__ — POSIX daemon implementation
//
// Auto-generated from the template-cpp skeleton.
// Forks into the background and handles SIGTERM / SIGINT gracefully.

#include "daemon.h"
#include <cstdio>
#include <cstdlib>

static volatile sig_atomic_t g_running = 1;

void aw_daemon_signal_handler(int signum) {
    (void)signum;
    g_running = 0;
}

int aw_daemon_run(void) {
    // Set up signal handlers.
    struct sigaction sa{};
    sa.sa_handler = aw_daemon_signal_handler;
    sigemptyset(&sa.sa_mask);
    sa.sa_flags = 0;
    sigaction(SIGTERM, &sa, nullptr);
    sigaction(SIGINT,  &sa, nullptr);

    // Fork into background.
    switch (fork()) {
        case -1:
            perror("fork");
            return 1;
        case 0:
            // Child: create new session, detach from terminal.
            setsid();
            break;
        default:
            // Parent: exit.
            return 0;
    }

    // Redirect standard streams.
    freopen("/dev/null", "r", stdin);
    freopen("/dev/null", "w", stdout);
    freopen("/dev/null", "w", stderr);

    // TODO: place your daemon logic here.
    // The daemon runs in this process until signaled.
    while (g_running) {
        sleep(1);
    }

    return 0;
}
