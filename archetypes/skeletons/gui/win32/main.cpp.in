// main.cpp — Win32 GUI executable entry point (WinMain)
//
// This file is a skeleton for a Windows GUI application built with
// aw_add_gui_executable().  The WIN32 flag suppresses the console
// subsystem so the executable runs as a pure GUI application.

#pragma once

/**
 * @file main.cpp
 * @brief Win32 GUI executable entry point (WinMain).
 */

#include <windows.h>

/**
 * @brief WinMain entry point for a GUI application.
 * Creates a GUI subsystem executable (no console window).
 *
 * @param hInstance    Current process instance handle.
 * @param hPrevInstance  Previous instance handle (always NULL on Win32).
 * @param lpCmdLine    Command-line string.
 * @param nCmdShow     Show state of the main window.
 * @return Exit code (0 = success).
 */
int WINAPI WinMain(HINSTANCE hInstance, HINSTANCE hPrevInstance,
                   LPSTR lpCmdLine, int nCmdShow) {
    (void)hInstance;
    (void)hPrevInstance;
    (void)lpCmdLine;
    (void)nCmdShow;

    // Application initialization.
    // TODO: Create window class, register class, create window,
    //       and enter message loop.

    return 0;
}
