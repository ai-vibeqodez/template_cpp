// service.cpp — Windows Service Control Manager service
//
// This file is a skeleton for a Windows SCM service built with
// aw_add_service_executable().  It registers a ServiceMain entry point
// and a ControlHandler for SCM commands (STOP, PAUSE, CONTINUE).

#include <windows.h>
#include <service.h>

// ---------------------------------------------------------------------------
// Global state
// ---------------------------------------------------------------------------

/** @brief Current service status reported to the SCM. */
static SERVICE_STATUS g_service_status{};

/** @brief Handle returned by RegisterServiceCtrlHandlerW. */
static SERVICE_STATUS_HANDLE g_service_handle{};

/** @brief Event signaled when the SCM requests a stop. */
static HANDLE g_stop_event{};

// ---------------------------------------------------------------------------
// service_control_handler
// ---------------------------------------------------------------------------

/**
 * @brief Service control handler — processes SCM commands.
 *
 * @param control The control code (SERVICE_CONTROL_STOP, etc.).
 */
static void WINAPI service_control_handler(DWORD control) {
    switch (control) {
        case SERVICE_CONTROL_STOP:
        case SERVICE_CONTROL_SHUTDOWN:
            g_service_status.dwWin32ExitCode = 0;
            g_service_status.dwCurrentState = SERVICE_STOPPED;
            SetEvent(g_stop_event);
            break;

        case SERVICE_CONTROL_PAUSE:
            g_service_status.dwCurrentState = SERVICE_PAUSED;
            break;

        case SERVICE_CONTROL_CONTINUE:
            g_service_status.dwCurrentState = SERVICE_RUNNING;
            break;

        case SERVICE_CONTROL_INTERROGATE:
            // No action needed — SCM will read g_service_status.
            break;

        default:
            // Ignore unrecognized control codes.
            break;
    }

    SetServiceStatus(g_service_handle, &g_service_status);
}

// ---------------------------------------------------------------------------
// service_main
// ---------------------------------------------------------------------------

/**
 * @brief ServiceMain — entry point registered with the SCM.
 *
 * @param argc Argument count.
 * @param argv Argument vector (wide strings).
 */
static void WINAPI service_main(DWORD argc, LPWSTR* argv) {
    (void)argc;
    (void)argv;

    g_service_handle =
        RegisterServiceCtrlHandlerW(SERVICE_NAME_W, service_control_handler);
    if (!g_service_handle) {
        return;
    }

    g_service_status.dwServiceType = SERVICE_WIN32_OWN_PROCESS;
    g_service_status.dwCurrentState = SERVICE_START_PENDING;
    g_service_status.dwControlsAccepted =
        SERVICE_STOP_ACCEPTED | SERVICE_PAUSE_CONTINUE_ACCEPTED;
    SetServiceStatus(g_service_handle, &g_service_status);

    g_stop_event = CreateEventW(nullptr, TRUE, FALSE, nullptr);
    if (!g_stop_event) {
        g_service_status.dwCurrentState = SERVICE_STOPPED;
        g_service_status.dwWin32ExitCode = ERROR_FAILED_SERVICE_CONTROLLER_CONNECT;
        SetServiceStatus(g_service_handle, &g_service_status);
        return;
    }

    // Transition to running state.
    g_service_status.dwCurrentState = SERVICE_RUNNING;
    SetServiceStatus(g_service_handle, &g_service_status);

    // Main service loop — blocks until g_stop_event is signaled.
    // TODO: Implement service-specific logic here.
    WaitForSingleObject(g_stop_event, INFINITE);

    // Cleanup.
    CloseHandle(g_stop_event);
    g_stop_event = nullptr;

    g_service_status.dwCurrentState = SERVICE_STOPPED;
    g_service_status.dwWin32ExitCode = 0;
    SetServiceStatus(g_service_handle, &g_service_status);
}

// ---------------------------------------------------------------------------
// main — entry point
// ---------------------------------------------------------------------------

/**
 * @brief Application entry point.
 *
 * Connects to the SCM via StartServiceCtrlDispatcherW.  If the process is
 * not running as a service (e.g. during debugging), falls back to a
 * foreground mode.
 *
 * @return Exit code (0 = success).
 */
int main() {
    SERVICE_TABLE_ENTRYW service_table[] = {
        {SERVICE_NAME_W, service_main},
        {nullptr, nullptr}
    };

    if (!StartServiceCtrlDispatcherW(service_table)) {
        // Not running as a service — fall back to foreground mode for
        // debugging.  ERROR_FAILED_SERVICE_CONTROLLER_CONNECT (1063) means
        // the dispatcher could not connect to the SCM.
        if (GetLastError() != ERROR_FAILED_SERVICE_CONTROLLER_CONNECT) {
            // Report unexpected errors.
            DWORD err = GetLastError();
            // TODO: Log or report err.
        }

        // Foreground fallback: run service_main directly for debugging.
        // In production this path should not be reached.
        // DWORD dummy_argc = 0;
        // LPWSTR* dummy_argv = nullptr;
        // service_main(dummy_argc, dummy_argv);
    }

    return 0;
}
