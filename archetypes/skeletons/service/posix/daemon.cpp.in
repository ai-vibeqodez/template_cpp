// daemon.cpp — POSIX daemon process with SIGTERM/SIGINT handling
//
// This file is a skeleton for a POSIX daemon built with
// aw_add_service_executable().  It implements the double-fork daemonize
// pattern, setsid, stdio redirection, and signal-based graceful shutdown.

#include <daemon.h>

#include <cerrno>
#include <cstdio>
#include <cstdlib>
#include <unistd.h>

#include <fcntl.h>

namespace aw::daemon {

// ---------------------------------------------------------------------------
// Static state
// ---------------------------------------------------------------------------

/** @brief Volatile flag set to false by SIGTERM/SIGINT handlers. */
static volatile sig_atomic_t g_running = 1;

// ---------------------------------------------------------------------------
// Signal handling
// ---------------------------------------------------------------------------

/**
 * @brief Signal handler for SIGTERM and SIGINT.
 *
 * Sets the running flag to false, triggering a graceful shutdown loop.
 *
 * @param signum The signal number received.
 */
static void signal_handler(int /*signum*/) {
    g_running = 0;
}

void Daemon::install_signal_handlers() {
    struct sigaction sa {};
    sa.sa_handler = signal_handler;
    sigemptyset(&sa.sa_mask);
    sa.sa_flags = 0;

    sigaction(SIGTERM, &sa, nullptr);
    sigaction(SIGINT, &sa, nullptr);

    // Ignore SIGHUP to prevent termination when the controlling terminal
    // is closed (already handled in daemonize(), but be explicit).
    signal(SIGHUP, SIG_IGN);
}

bool Daemon::is_running() {
    return g_running != 0;
}

// ---------------------------------------------------------------------------
// Daemonization
// ---------------------------------------------------------------------------

bool Daemon::daemonize() {
    // First fork: detach from parent.
    switch (fork()) {
        case -1:
            return false;
        case 0:
            // Child continues.
            break;
        default:
            // Parent exits.
            _exit(0);
    }

    // Create a new session — we become the session leader.
    if (setsid() == -1) {
        return false;
    }

    // Ignore SIGHUP during daemonization.
    signal(SIGHUP, SIG_IGN);

    // Second fork: ensure we cannot re-acquire a terminal.
    switch (fork()) {
        case -1:
            return false;
        case 0:
            // Second child continues.
            break;
        default:
            // First child exits.
            _exit(0);
    }

    // Redirect stdio to /dev/null.
    int dev_null = open("/dev/null", O_RDWR);
    if (dev_null >= 0) {
        dup2(dev_null, STDIN_FILENO);
        dup2(dev_null, STDOUT_FILENO);
        dup2(dev_null, STDERR_FILENO);
        if (dev_null > STDERR_FILENO) {
            close(dev_null);
        }
    }

    // Change working directory to root.
    if (chdir("/") != 0) {
        return false;
    }

    // Clear file mode creation mask.
    umask(0);

    return true;
}

// ---------------------------------------------------------------------------
// systemd notification
// ---------------------------------------------------------------------------

void Daemon::notify_systemd_ready() {
#ifdef HAVE_LIBSYSTEMD
    // sd_notify(0, "READY=1");
    // Uncomment when libsystemd is linked.
#endif
    (void)0; // Placeholder — implement when libsystemd is linked.
}

// ---------------------------------------------------------------------------
// main
// ---------------------------------------------------------------------------

/**
 * @brief Application entry point.
 *
 * Installs signal handlers, daemonizes, notifies systemd, and runs the
 * main daemon loop.
 *
 * @return Exit code (0 = success, 1 = error).
 */
int main() {
    // Install signal handlers before daemonizing.
    Daemon::install_signal_handlers();

    // Daemonize (fork + setsid + stdio redirect).
    if (!Daemon::daemonize()) {
        fprintf(stderr, "Failed to daemonize\n");
        return 1;
    }

    // Notify systemd that initialization is complete.
    Daemon::notify_systemd_ready();

    // Main daemon loop.
    // TODO: Implement daemon-specific logic here.
    while (Daemon::is_running()) {
        sleep(1);
    }

    // Cleanup before exit.
    // TODO: Implement shutdown logic.

    return 0;
}

} // namespace aw::daemon
