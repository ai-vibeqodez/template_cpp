# =============================================================================
# Example: how to call aw_add_kernel_driver() from your project's
# root CMakeLists.txt for a Windows WDK kernel driver.
#
# Copy this block and adapt the target name, source paths, and optional
# arguments to your project.
# =============================================================================

aw_add_kernel_driver(TARGET my_driver
    SOURCES src/driver.cpp
    HEADERS include/driver.h
    PLATFORM windows
    WDK_VERSION 10.0
    # WDK_DIR "C:/Program Files (x86)/Windows Kits/10"
)
