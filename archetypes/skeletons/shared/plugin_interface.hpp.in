#pragma once

/**
 * @file plugin_interface.hpp
 * @brief Abstract plugin interface — all plugins must implement this.
 *
 * Replace the namespace and class names to match your project.
 * Every plugin must implement name(), version(), initialize(), and cleanup().
 */

#include <string_view>

#include "export_macro.hpp"

namespace aw::plugin {

/**
 * @class IPlugin
 * @brief Abstract base class for all plugin modules.
 *
 * Host applications create plugin instances via the extern "C" factory
 * function and release them through destroy_plugin().
 */
class AW_API IPlugin {
public:
    virtual ~IPlugin() = default;

    /**
     * @brief Returns the plugin name.
     * @return A non-empty plugin identifier.
     */
    [[nodiscard]] virtual std::string_view name() const = 0;

    /**
     * @brief Returns the plugin version.
     * @return Version string in "X.Y.Z" format.
     */
    [[nodiscard]] virtual std::string_view version() const = 0;

    /**
     * @brief Initialize the plugin. Called once after creation.
     *
     * Implementations should throw on failure; the host will reject
     * plugins whose initialize() throws.
     */
    virtual void initialize() = 0;

    /**
     * @brief Cleanup the plugin. Called once before destruction.
     */
    virtual void cleanup() = 0;
};

} // namespace aw::plugin
