#pragma once

/**
 * @file daemon.h
 * @brief Public header for the POSIX daemon process.
 *
 * Replace "myapp" with your application name and update the namespace
 * accordingly.
 */

#include <csignal>
#include <cstdint>

namespace aw::daemon {

/**
 * @class Daemon
 * @brief POSIX daemon process with fork/setsid and signal handling.
 *
 * Provides daemonization (double-fork, setsid, stdio redirection) and
 * SIGTERM/SIGINT handlers for graceful shutdown.
 */
class [[nodiscard]] Daemon {
public:
    /**
     * @brief Daemonize the current process.
     *
     * Performs a double fork, calls setsid(), closes stdio, changes
     * working directory to /, and clears the file mode creation mask.
     *
     * @return true on success, false on failure.
     */
    static bool daemonize();

    /**
     * @brief Notify systemd that the daemon is ready.
     *
     * Uses sd_notify() from libsystemd if available; no-op otherwise.
     */
    static void notify_systemd_ready();

    /**
     * @brief Install signal handlers for SIGTERM and SIGINT.
     *
     * Both signals set the running flag to false for graceful shutdown.
     */
    static void install_signal_handlers();

    /**
     * @brief Check whether the daemon should keep running.
     * @return true if the daemon is still active.
     */
    static bool is_running();
};

} // namespace aw::daemon
