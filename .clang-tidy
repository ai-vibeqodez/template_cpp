# Opt-in tool for local use (not run in CI). Needs compile_commands.json: configure with CMake first.
#   clang-tidy -p build/dev <file>
#
# Approach: * (all checks) minus exclusions — similar to nlohmann/json.
# This catches new bugs automatically as LLVM adds new checks.

Checks: >
  -*,
  *,
  bugprone-*,
  cppcoreguidelines-avoid-capturing-lambda-coroutines,
  cppcoreguidelines-avoid-reference-coroutine-parameters,
  cppcoreguidelines-missing-std-forward,
  cppcoreguidelines-slicing,
  misc-const-correctness,
  misc-definitions-in-headers,
  misc-unused-using-decls,
  modernize-use-nodiscard,
  modernize-use-override,
  modernize-use-using,
  performance-*,
  readability-container-size-empty,
  readability-redundant-member-init,
  # --- Exclusions ---
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  -bugprone-unchecked-optional-access
WarningsAsErrors: ''
HeaderFilterRegex: '.*/include/.*'
FormatStyle: file
