# =============================================================================
# CMakeLists.txt.example — How to use aw_add_cxx_module_library()
#
# This file demonstrates the invocation pattern for the C++20 module library
# archetype.  Copy and adapt it for your own module-based library.
# =============================================================================

# ---------------------------------------------------------------------------
# Create a C++20 module library target
# ---------------------------------------------------------------------------
#
# On CMake 3.28+ this uses FILE_SET CXX_MODULES under the hood.
# On older CMake versions it falls back to a STATIC library with a warning.
#
aw_add_cxx_module_library(TARGET my_module
    MODULES
        src/my_module.cppm
    HEADERS
        include/aw/my_module/my_module.hin
    BASE_DIRS
        include
    LINK_LIBRARIES
        Threads::Threads
    COMPILE_DEFINITIONS
        MY_MODULE_VERSION="1.0.0"
    MODULE_NAME
        my_module
)
