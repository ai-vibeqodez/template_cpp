# @TARGET@.service — systemd unit file for the aw::service daemon
#
# Install to: /etc/systemd/system/@TARGET@.service
# Enable:     systemctl enable @TARGET@
# Start:      systemctl start @TARGET@
#
# This template is generated by aw_add_service_executable() via
# configure_file().  Do not edit manually.

[Unit]
Description=@SERVICE_DISPLAY_NAME@
After=network.target

[Service]
Type=notify
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/@TARGET@
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@CMAKE_INSTALL_PREFIX@

# Security hardening.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=@CMAKE_INSTALL_PREFIX@/var

# Restart policy.
Restart=on-failure
RestartSec=5s

# Logging.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=@SERVICE_NAME@

[Install]
WantedBy=multi-user.target
