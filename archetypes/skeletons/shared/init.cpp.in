// init.cpp — POSIX library initialization / cleanup
//
// This file is automatically included in every SHARED library target
// built with aw_add_shared_library() on Linux/macOS.

#include <cstdio>

#if defined(__GNUC__) || defined(__clang__)
    #define AW_LIBRARY_INIT __attribute__((constructor))
    #define AW_LIBRARY_FINI __attribute__((destructor))
#else
    #define AW_LIBRARY_INIT
    #define AW_LIBRARY_FINI
#endif

AW_LIBRARY_INIT
static void library_init() {
    // Library initialization code.
}

AW_LIBRARY_FINI
static void library_fini() {
    // Library cleanup code.
}
