<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg"
     viewBox="0 0 64 64"
     width="64"
     height="64">
  <!--
    symbolic.svg — Linux application icon template
    This scalable SVG icon is installed to
    share/icons/hicolor/scalable/apps/ for desktop integration.
  -->
  <rect width="64" height="64" rx="12" fill="#4a90d9"/>
  <text x="32" y="42"
        text-anchor="middle"
        font-family="sans-serif"
        font-size="32"
        font-weight="bold"
        fill="white">
    @APP_NAME_FIRST_CHAR@
  </text>
</svg>
